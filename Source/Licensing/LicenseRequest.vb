Option Strict On

Imports System.Globalization
Imports System.Linq
Imports System.Text

''' <summary>A customer's request for a paid license, generated by the app's registration screen
''' and sent to the vendor by whatever channel the customer has available (email, chat, USB,
''' etc.) - this is a convenience data transfer, not a security credential. The vendor loads it
''' into the Keygen tool to pre-fill the fields before issuing the signed license key.</summary>
Public NotInheritable Class LicenseRequest
    Private Const FormatVersion As Integer = 1
    Private Const FieldCount As Integer = 6

    Public Property Product As String = LicensePayload.CurrentProduct
    Public Property RequestCode As String = String.Empty
    Public Property Licensee As String = String.Empty
    Public Property Email As String = String.Empty
    Public Property RequestedPlan As LicensePlan
    Public Property RequestedUtc As DateTime

    ''' <summary>Serializes to the plain-text ".eoreq" file format.</summary>
    Public Function ToFileText() As String
        Return String.Join("|",
            FormatVersion.ToString(CultureInfo.InvariantCulture),
            Product,
            RequestCode,
            Convert.ToBase64String(Encoding.UTF8.GetBytes(If(Licensee, String.Empty))),
            Convert.ToBase64String(Encoding.UTF8.GetBytes(If(Email, String.Empty))),
            RequestedPlan.ToString()) &
            Environment.NewLine & "RequestedUtc=" & RequestedUtc.ToString("O", CultureInfo.InvariantCulture)
    End Function

    ''' <summary>A human-readable rendering for an email body or on-screen preview.</summary>
    Public Function ToDisplayText() As String
        Return String.Join(Environment.NewLine,
            "Electrical Operation Center - License Request",
            "",
            "Name: " & Licensee,
            "Email: " & Email,
            "Requested plan: " & LicensePayload.PlanDisplayName(RequestedPlan),
            "Request code: " & RequestCode,
            "Requested on: " & RequestedUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture))
    End Function

    Public Shared Function TryParse(text As String, ByRef result As LicenseRequest) As Boolean
        result = Nothing
        Try
            If String.IsNullOrWhiteSpace(text) Then Return False
            Dim lines = text.Replace(vbCrLf, vbLf).Split(vbLf(0))
            If lines.Length = 0 Then Return False
            Dim parts = lines(0).Split("|"c)
            If parts.Length <> FieldCount Then Return False
            If Not String.Equals(parts(0), FormatVersion.ToString(CultureInfo.InvariantCulture), StringComparison.Ordinal) Then Return False
            Dim requestedUtc = DateTime.UtcNow
            Dim marker = lines.Skip(1).FirstOrDefault(Function(l) l.StartsWith("RequestedUtc=", StringComparison.Ordinal))
            If marker IsNot Nothing Then
                DateTime.TryParse(marker.Substring("RequestedUtc=".Length), CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, requestedUtc)
            End If
            result = New LicenseRequest With {
                .Product = parts(1),
                .RequestCode = parts(2),
                .Licensee = Encoding.UTF8.GetString(Convert.FromBase64String(parts(3))),
                .Email = Encoding.UTF8.GetString(Convert.FromBase64String(parts(4))),
                .RequestedPlan = CType([Enum].Parse(GetType(LicensePlan), parts(5)), LicensePlan),
                .RequestedUtc = requestedUtc
            }
            Return True
        Catch
            result = Nothing
            Return False
        End Try
    End Function
End Class
